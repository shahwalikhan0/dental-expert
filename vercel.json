{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "crons": [
    {
      "path": "/api/cron/dispatch",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/stock-alerts",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/communications/triggers",
      "schedule": "0 8 * * *"
    }
  ]
}
