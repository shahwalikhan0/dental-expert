// Dental Hospital Management System - Database Schema
// Multi-Tenant SaaS Architecture

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== MULTI-TENANCY ====================

model Hospital {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  email               String    @unique
  phone               String?
  alternatePhone      String?
  address             String?   @db.Text
  city                String?
  state               String?
  // "PIN code" is India's term; Pakistan Post calls it a postal code.
  postalCode          String?
  logo                String?
  registrationNo      String?
  // Tax identifiers. Renamed from the Indian gstNumber/panNumber: Pakistan
  // issues an STRN for sales-tax registration and an NTN for income tax.
  taxRegistrationNo   String?
  nationalTaxNo       String?
  // Sales tax on services, off by default because dental services are exempt
  // for this clinic. Turning it on is a settings change, not a migration:
  // set taxEnabled, a rate and the label to print on invoices.
  taxEnabled          Boolean   @default(false)
  taxRate             Decimal   @default(0) @db.Decimal(5, 2)
  taxLabel            String    @default("Sales Tax")
  website             String?
  tagline             String?

  // Localization. `country` will select the tax provider — see
  // docs/LOCALIZATION.md. All four defaults are Pakistan: leaving three of them
  // on Indian values while `locale` said en-PK meant a clinic created without
  // an explicit setting billed in rupees on Kolkata time.
  locale              String    @default("en-PK")
  country             String    @default("PK")
  currency            String    @default("PKR")
  timezone            String    @default("Asia/Karachi")

  plan                Plan      @default(FREE)
  planExpiresAt       DateTime?
  patientLimit        Int       @default(100)
  staffLimit          Int       @default(3)
  storageLimitMb      Int       @default(500)

  isActive            Boolean   @default(true)
  onboardingCompleted Boolean   @default(false)

  emailVerificationToken  String?
  emailVerificationExpiry DateTime?

  workingHours        String?   @db.Text
  bankName            String?
  bankAccountNo       String?
  bankAccountName     String?
  // IBAN, not an IFSC code: IFSC is India's bank routing identifier. Pakistani
  // accounts are identified by a 24-character IBAN (PK + 2 check digits + 4
  // bank code + 16 account number).
  bankIban            String?
  upiId               String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users               User[]
  staff               Staff[]
  patients            Patient[]
  appointments        Appointment[]
  chairs              Chair[]
  refunds             Refund[]
  cashierSessions     CashierSession[]
  treatmentAddenda    TreatmentAddendum[]
  treatmentRevisions  TreatmentRevision[]
  treatments          Treatment[]
  treatmentPlans      TreatmentPlan[]
  dentalChartEntries  DentalChartEntry[]
  prescriptions       Prescription[]
  procedures          Procedure[]
  medications         Medication[]
  invoices            Invoice[]
  payments            Payment[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  inventoryBatches    InventoryBatch[]
  stockTransactions   StockTransaction[]
  stockAlerts         StockAlert[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  labVendors          LabVendor[]
  labOrders           LabOrder[]
  documents           Document[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  settings            Setting[]
  holidays            Holiday[]
  communicationTemplates CommunicationTemplate[]
  smsLogs             SMSLog[]
  emailLogs           EmailLog[]
  bulkCommunications  BulkCommunication[]
  staffInvites        StaffInvite[]
  staffShifts         StaffShift[]
  patientPortalEnabled Boolean   @default(false)

  formTemplates       FormTemplate[]
  formSubmissions     FormSubmission[]
  waitlistEntries     Waitlist[]
  dataImportJobs      DataImportJob[]

  @@index([slug])
  @@index([plan])
  @@index([isActive])
}

enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
  SELF_HOSTED
}

// ==================== SUBSCRIPTION & BILLING ====================

// ==================== AUTHENTICATION & USERS ====================

model User {
  id              String    @id @default(cuid())
  hospitalId      String
  email           String    @unique
  password        String
  name            String
  phone           String?
  role            Role      @default(RECEPTIONIST)
  // Optional second role, for the person who holds two jobs — most often the
  // owner who also treats patients. Permissions become the union of the two.
  //
  // This exists because `role` alone forces a false choice on that person:
  // ADMIN deliberately cannot sign a clinical note (FR-007 wants a signature
  // to attest as the treating provider), so an owner-dentist with a single
  // ADMIN account could not sign their own work. Only clinical roles are
  // assignable here — see SECONDARY_ROLES in lib/rbac.ts.
  clinicalRole    Role?
  isActive        Boolean   @default(true)
  isHospitalAdmin Boolean   @default(false)
  emailVerified   DateTime?
  image           String?
  mustChangePassword Boolean @default(false)

  // Personal locale override, BCP 47. NULL means "inherit from the clinic" and
  // is deliberately NOT defaulted: a default would be indistinguishable from an
  // explicit choice of en-IN, so a clinic changing its own locale would
  // silently fail to propagate to every staff member who never expressed a
  // preference. See docs/LOCALIZATION.md.
  locale          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff           Staff?
  auditLogs       AuditLog[]
  notifications   Notification[]
  dataImportJobs  DataImportJob[]
  acknowledgedStockAlerts StockAlert[]
  labOrderStatusChanges   LabOrderHistory[]
  uploadedLabOrderDocuments LabOrderDocument[]
  discountsRequested      Invoice[]        @relation("DiscountsRequested")
  discountsApproved       Invoice[]        @relation("DiscountsApproved")
  refundsAuthorised       Refund[]         @relation("RefundsAuthorised")
  paymentsRecorded        Payment[]        @relation("PaymentsRecorded")
  cashierSessionsOpened   CashierSession[] @relation("CashierSessionsOpened")
  cashierSessionsClosed   CashierSession[] @relation("CashierSessionsClosed")
  treatmentsSigned        Treatment[]         @relation("TreatmentsSigned")
  treatmentAddenda        TreatmentAddendum[] @relation("TreatmentAddenda")
  treatmentAmendments     TreatmentRevision[] @relation("TreatmentAmendments")

  @@index([email])
  @@index([role])
  @@index([hospitalId])
}

// The seven roles of specification §4, plus LAB_TECH for the dental-laboratory
// coordination of §5.8. Spec name -> enum value:
//
//   System Administrator  -> ADMIN
//   Clinic Manager        -> CLINIC_MANAGER
//   Dentist               -> DOCTOR
//   Dental Assistant      -> DENTAL_ASSISTANT
//   Front Desk/Reception  -> RECEPTIONIST
//   Accounts/Cashier      -> ACCOUNTANT
//   Inventory/Store       -> INVENTORY_STAFF
//
// What each one may actually do lives in lib/rbac.ts, not here. Adding a value
// to this enum grants nothing on its own.
enum Role {
  ADMIN
  CLINIC_MANAGER
  DOCTOR
  DENTAL_ASSISTANT
  RECEPTIONIST
  ACCOUNTANT
  INVENTORY_STAFF
  LAB_TECH
}

// ==================== STAFF INVITES ====================

model StaffInvite {
  id          String            @id @default(cuid())
  hospitalId  String
  email       String
  name        String?
  phone       String?
  role        Role
  invitedBy   String
  token       String            @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      StaffInviteStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  hospital    Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([email])
  @@index([token])
  @@index([status])
}

enum StaffInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ==================== STAFF MANAGEMENT ====================

model Staff {
  id              String    @id @default(cuid())
  hospitalId      String
  userId          String    @unique
  employeeId      String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  phone           String
  alternatePhone  String?
  email           String
  address         String?   @db.Text
  city            String?
  state           String?
  postalCode      String?
  // Pakistan's national identity number. Aadhaar is India's, 12 digits;
  // a CNIC is 13, issued by NADRA. Stored as digits only and formatted
  // 00000-0000000-0 for display — see lib/cnic.ts.
  cnic            String?
  nationalTaxNo   String?
  qualification   String?
  specialization  String?
  licenseNumber   String?
  joiningDate     DateTime  @default(now())
  salary          Decimal?  @db.Decimal(10, 2)
  bankAccountNo   String?
  bankIban        String?
  emergencyContact String?
  emergencyPhone  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments    Appointment[] @relation("DoctorAppointments")
  treatments      Treatment[]
  prescriptions   Prescription[]
  shifts          StaffShift[]

  @@unique([hospitalId, employeeId])
  // One person, one CNIC. PostgreSQL treats NULLs as distinct in a unique
  // index, so the many staff without one recorded do not collide.
  @@unique([hospitalId, cnic])
  @@index([hospitalId])
  @@index([phone])
}

model StaffShift {
  id          String    @id @default(cuid())
  hospitalId  String
  staffId     String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isActive    Boolean   @default(true)

  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff       Staff     @relation(fields: [staffId], references: [id])

  @@unique([staffId, dayOfWeek])
  @@index([hospitalId])
}

// ==================== PATIENT MANAGEMENT ====================

model Patient {
  id              String     @id @default(cuid())
  hospitalId      String
  patientId       String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  age             Int?
  gender          Gender?
  bloodGroup      BloodGroup?
  phone           String
  alternatePhone  String?
  email           String?
  address         String?    @db.Text
  city            String?
  // No default: the upstream schema defaulted this to "Tamil Nadu", which
  // silently stamped an Indian state onto every Pakistani patient. There is no
  // right default — the clinic's own province is a guess for anyone who
  // travelled in — so it is left blank.
  state           String?
  postalCode      String?
  // See the note on Staff.cnic. Children are issued a B-Form rather than a
  // CNIC, so this is nullable and stays that way.
  cnic            String?
  occupation      String?
  referredBy      String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Locale override for the patient portal. NULL means "inherit from the
  // clinic" — same reasoning as User.locale above.
  locale          String?

  aiSummary       Json?
  aiSummaryAt     DateTime?

  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  hospital        Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  medicalHistory  MedicalHistory?
  appointments    Appointment[]
  treatments      Treatment[]
  treatmentPlans  TreatmentPlan[]
  dentalChart     DentalChartEntry[]
  prescriptions   Prescription[]
  invoices        Invoice[]
  documents       Document[]
  labOrders       LabOrder[]

  @@unique([hospitalId, patientId])
  // FR-002 duplicate prevention. A CNIC identifies one person, so two patient
  // records carrying the same one are the same patient twice. NULLs stay
  // distinct, which matters: children hold a B-Form, not a CNIC.
  @@unique([hospitalId, cnic])
  @@index([hospitalId])
  @@index([phone])
  @@index([firstName, lastName])
}

model MedicalHistory {
  id                String    @id @default(cuid())
  patientId         String    @unique

  hasAllergies      Boolean   @default(false)
  drugAllergies     String?   @db.Text
  foodAllergies     String?
  materialAllergies String?

  hasDiabetes       Boolean   @default(false)
  diabetesType      String?
  hasHypertension   Boolean   @default(false)
  hasHeartDisease   Boolean   @default(false)
  heartCondition    String?
  hasBleedingDisorder Boolean @default(false)
  hasAsthma         Boolean   @default(false)
  hasThyroid        Boolean   @default(false)
  thyroidType       String?
  hasHepatitis      Boolean   @default(false)
  hepatitisType     String?
  hasHiv            Boolean   @default(false)
  hasEpilepsy       Boolean   @default(false)
  isPregnant        Boolean   @default(false)
  pregnancyWeeks    Int?
  otherConditions   String?   @db.Text

  currentMedications String?  @db.Text

  previousDentalWork String?  @db.Text
  lastDentalVisit   DateTime?
  dentalAnxietyLevel Int?     @default(0)

  familyDentalHistory String? @db.Text

  smokingStatus     SmokingStatus @default(NEVER)
  alcoholConsumption AlcoholConsumption @default(NEVER)
  tobaccoChewing    Boolean   @default(false)

  additionalNotes   String?   @db.Text

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
  OCCASIONAL
}

enum AlcoholConsumption {
  NEVER
  OCCASIONAL
  MODERATE
  HEAVY
}

// ==================== APPOINTMENT SCHEDULING ====================

model Appointment {
  id              String            @id @default(cuid())
  hospitalId      String
  appointmentNo   String
  patientId       String
  doctorId        String

  scheduledDate   DateTime          @db.Date
  scheduledTime   String
  duration        Int               @default(30)
  chairId         String?

  appointmentType AppointmentType   @default(CONSULTATION)
  status          AppointmentStatus @default(SCHEDULED)
  priority        Priority          @default(NORMAL)

  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  waitTime        Int?

  chiefComplaint  String?           @db.Text
  notes           String?           @db.Text

  cancelledAt     DateTime?
  cancellationReason String?


  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient           @relation(fields: [patientId], references: [id])
  doctor          Staff             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  chair           Chair?            @relation(fields: [chairId], references: [id], onDelete: SetNull)
  treatments      Treatment[]
  reminders       AppointmentReminder[]

  @@unique([hospitalId, appointmentNo])
  @@index([hospitalId])
  @@index([scheduledDate])
  @@index([patientId])
  @@index([doctorId])
  @@index([chairId])
  @@index([status])
}

/// A treatment chair / operatory. FR-025 lists chairs among the master data a
/// clinic maintains, and FR-004 requires double-booking to be caught on the
/// chair as well as the doctor — neither is possible while a chair is only a
/// free-typed integer on the appointment.
model Chair {
  id              String    @id @default(cuid())
  hospitalId      String
  name            String
  room            String?
  notes           String?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model AppointmentReminder {
  id              String         @id @default(cuid())
  appointmentId   String
  reminderType    ReminderType
  scheduledFor    DateTime
  sentAt          DateTime?
  status          ReminderStatus @default(PENDING)
  createdAt       DateTime       @default(now())

  appointment     Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([scheduledFor])
  @@index([status])
}

enum AppointmentType {
  CONSULTATION
  PROCEDURE
  FOLLOW_UP
  EMERGENCY
  CHECK_UP
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReminderType {
  SMS
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// ==================== DENTAL CHART ====================

model DentalChartEntry {
  id              String         @id @default(cuid())
  hospitalId      String
  patientId       String
  toothNumber     Int
  toothNotation   String

  mesial          Boolean        @default(false)
  distal          Boolean        @default(false)
  occlusal        Boolean        @default(false)
  buccal          Boolean        @default(false)
  lingual         Boolean        @default(false)

  condition       ToothCondition
  severity        Severity       @default(MILD)

  notes           String?
  diagnosedDate   DateTime       @default(now())
  resolvedDate    DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([toothNumber])
}

enum ToothCondition {
  HEALTHY
  CARIES
  FILLED
  CROWN
  BRIDGE
  IMPLANT
  ROOT_CANAL
  EXTRACTION
  MISSING
  FRACTURED
  SENSITIVE
  MOBILITY
  ABSCESS
  PERIODONTAL
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

// ==================== TREATMENT & CLINICAL ====================

model Procedure {
  id              String            @id @default(cuid())
  hospitalId      String
  code            String
  name            String
  category        ProcedureCategory
  description     String?           @db.Text
  defaultDuration Int               @default(30)
  basePrice       Decimal           @db.Decimal(10, 2)

  materials       String?           @db.Text

  preInstructions String?           @db.Text
  postInstructions String?          @db.Text

  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatments      Treatment[]
  treatmentPlanItems TreatmentPlanItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([category])
}

enum ProcedureCategory {
  PREVENTIVE
  RESTORATIVE
  ENDODONTIC
  PERIODONTIC
  PROSTHODONTIC
  ORTHODONTIC
  ORAL_SURGERY
  COSMETIC
  DIAGNOSTIC
  EMERGENCY
}

model TreatmentPlan {
  id              String              @id @default(cuid())
  hospitalId      String
  planNumber      String
  patientId       String

  title           String
  description     String?             @db.Text
  status          TreatmentPlanStatus @default(DRAFT)

  estimatedCost   Decimal             @db.Decimal(10, 2)
  estimatedDuration Int?

  startDate       DateTime?
  expectedEndDate DateTime?
  completedDate   DateTime?

  consentGiven    Boolean             @default(false)
  consentDate     DateTime?

  notes           String?             @db.Text

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient             @relation(fields: [patientId], references: [id])
  items           TreatmentPlanItem[]

  @@unique([hospitalId, planNumber])
  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
}

model TreatmentPlanItem {
  id              String                  @id @default(cuid())
  treatmentPlanId String
  procedureId     String

  toothNumbers    String?
  priority        Int                     @default(1)
  estimatedCost   Decimal                 @db.Decimal(10, 2)
  status          TreatmentPlanItemStatus @default(PENDING)

  notes           String?

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  treatmentPlan   TreatmentPlan           @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedure       Procedure               @relation(fields: [procedureId], references: [id])

  @@index([treatmentPlanId])
}

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentPlanItemStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Treatment {
  id              String          @id @default(cuid())
  hospitalId      String
  treatmentNo     String
  patientId       String
  appointmentId   String?
  procedureId     String
  doctorId        String

  toothNumbers    String?
  chiefComplaint  String?         @db.Text
  diagnosis       String?         @db.Text
  findings        String?         @db.Text
  procedureNotes  String?         @db.Text

  materialsUsed   String?         @db.Text

  status          TreatmentStatus @default(IN_PROGRESS)
  startTime       DateTime?
  endTime         DateTime?

  complications   String?         @db.Text

  followUpRequired Boolean        @default(false)
  followUpDate    DateTime?
  followUpNotes   String?

  cost            Decimal         @db.Decimal(10, 2)

  // FR-007: "Completed/signed notes must be locked or version-controlled with
  // audit history for later amendments."
  //
  // There is no separate `isLocked`: signed *is* locked, and a second flag is
  // one more thing that can disagree with the first. `COMPLETED` is a workflow
  // status, not an attestation — a note is only signed when a clinician puts
  // their name to it.
  signedById      String?
  signedAt        DateTime?
  // Set the first time a signed note is amended, so a reader can see at a
  // glance that what they are looking at is not what was originally signed.
  amendedAt       DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  hospital        Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id])
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  procedure       Procedure       @relation(fields: [procedureId], references: [id])
  doctor          Staff           @relation(fields: [doctorId], references: [id])
  signedBy        User?           @relation("TreatmentsSigned", fields: [signedById], references: [id])
  addenda         TreatmentAddendum[]
  revisions       TreatmentRevision[]
  invoiceItems    InvoiceItem[]
  documents       Document[]

  @@unique([hospitalId, treatmentNo])
  @@index([hospitalId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([doctorId])
  @@index([signedById])
}

/// An addition made to a clinical note after it was signed.
///
/// The normal way to say something further about a treatment. The signed note
/// itself is never touched: an addendum is appended, attributed and dated, and
/// cannot be edited or removed once written. This is what "later amendments"
/// means in FR-007 for anything that is not a factual correction.
model TreatmentAddendum {
  id              String    @id @default(cuid())
  hospitalId      String
  treatmentId     String

  body            String    @db.Text
  authorId        String

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatment       Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  author          User      @relation("TreatmentAddenda", fields: [authorId], references: [id])

  @@index([hospitalId])
  @@index([treatmentId])
}

/// What a signed clinical note said before it was corrected.
///
/// Addenda cover almost everything, but not a wrong value in a structured
/// field: a note recording tooth 26 when the work was on 27 leaves every report
/// on tooth 26 wrong, and an addendum saying so does not fix the data. So a
/// signed note *can* be corrected — by a clinician, with a reason — and this
/// records what it said beforehand.
model TreatmentRevision {
  id              String    @id @default(cuid())
  hospitalId      String
  treatmentId     String

  reason          String    @db.Text
  /// `{ field: { from, to } }` for each field this amendment changed.
  changes         Json
  amendedById     String

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatment       Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  amendedBy       User      @relation("TreatmentAmendments", fields: [amendedById], references: [id])

  @@index([hospitalId])
  @@index([treatmentId])
}

enum TreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Prescription {
  id              String       @id @default(cuid())
  hospitalId      String
  prescriptionNo  String
  patientId       String
  doctorId        String

  diagnosis       String?
  notes           String?      @db.Text

  validUntil      DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id])
  doctor          Staff        @relation(fields: [doctorId], references: [id])
  medications     PrescriptionMedication[]

  @@unique([hospitalId, prescriptionNo])
  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
}

model PrescriptionMedication {
  id              String        @id @default(cuid())
  prescriptionId  String
  medicationId    String?

  medicationName  String
  dosage          String
  frequency       String
  duration        String
  route           String        @default("Oral")
  timing          String?
  quantity        Int?
  instructions    String?

  createdAt       DateTime      @default(now())

  prescription    Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication      Medication?   @relation(fields: [medicationId], references: [id])
}

model Medication {
  id              String       @id @default(cuid())
  hospitalId      String
  name            String
  genericName     String?
  category        String?
  form            String?
  strength        String?
  manufacturer    String?
  defaultDosage   String?
  defaultFrequency String?
  defaultDuration String?
  contraindications String?    @db.Text
  sideEffects     String?      @db.Text
  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescriptionMedications PrescriptionMedication[]

  @@index([hospitalId])
  @@index([name])
}

// ==================== BILLING & FINANCIAL ====================

model Invoice {
  id              String        @id @default(cuid())
  hospitalId      String
  invoiceNo       String
  patientId       String

  subtotal        Decimal       @db.Decimal(10, 2)
  discountType    DiscountType?
  discountValue   Decimal?      @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)

  // FR-013: a discount over the clinic's threshold needs a reason and an
  // approver who is not the person raising the invoice. Reception holds
  // `billing:write` but not `billing:discount`, so their request sits PENDING
  // and the invoice cannot leave DRAFT until a manager decides.
  discountReason         String?                @db.Text
  discountApprovalStatus DiscountApprovalStatus @default(NOT_REQUIRED)
  discountRequestedById  String?
  discountApprovedById   String?
  discountDecidedAt      DateTime?
  discountDecisionNote   String?                @db.Text
  taxableAmount   Decimal       @db.Decimal(10, 2)
  // One tax line, stamped onto the invoice at the moment it is raised.
  //
  // Upstream carried India's two-component split (CGST + SGST at 9% each).
  // Pakistan levies a single provincial sales tax on services, and dental
  // services are exempt for this clinic — hence the 0 default. The rate lives
  // on the invoice rather than being read from settings at display time so
  // that reprinting an old invoice shows the tax that was actually charged,
  // not today's rate.
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal       @db.Decimal(10, 2)

  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?

  insuranceAmount Decimal?      @db.Decimal(10, 2)

  notes           String?       @db.Text
  termsAndConditions String?    @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  discountRequestedBy User?     @relation("DiscountsRequested", fields: [discountRequestedById], references: [id])
  discountApprovedBy  User?     @relation("DiscountsApproved", fields: [discountApprovedById], references: [id])

  @@unique([hospitalId, invoiceNo])
  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

/// FR-014 — "Record refund amount, method, reason, authorizer, and link to
/// original transaction."
///
/// A refund is its own transaction, not an edit of the payment it reverses.
/// The previous implementation mutated `Payment.refundAmount` in place, which
/// recorded no authoriser, could not express a refund paid back by a different
/// method than it came in, and refused any second refund — so a partial refund
/// could never be followed by another.
model Refund {
  id              String        @id @default(cuid())
  hospitalId      String
  refundNo        String
  paymentId       String

  amount          Decimal       @db.Decimal(10, 2)
  /// May differ from the original payment: card takings are often refunded in
  /// cash, and the till reconciliation has to see the outflow under the method
  /// the money actually left by.
  refundMethod    PaymentMethod
  reason          String        @db.Text
  authorisedById  String
  cashierSessionId String?

  transactionId   String?
  refundedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  payment         Payment         @relation(fields: [paymentId], references: [id])
  authorisedBy    User            @relation("RefundsAuthorised", fields: [authorisedById], references: [id])
  cashierSession  CashierSession? @relation(fields: [cashierSessionId], references: [id])

  @@unique([hospitalId, refundNo])
  @@index([hospitalId])
  @@index([paymentId])
  @@index([cashierSessionId])
  @@index([refundedAt])
}

/// FR-015 — "Provide daily cashier/payment-method reconciliation and variance
/// record."
///
/// A till: opened with a float, collecting the payments and refunds taken while
/// it is open, closed against a physical count per payment method.
model CashierSession {
  id              String               @id @default(cuid())
  hospitalId      String
  sessionNo       String
  status          CashierSessionStatus @default(OPEN)

  openingFloat    Decimal              @default(0) @db.Decimal(10, 2)
  openedById      String
  openedAt        DateTime             @default(now())
  openingNotes    String?              @db.Text

  closedById      String?
  closedAt        DateTime?
  closingNotes    String?              @db.Text

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  hospital        Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  openedBy        User                  @relation("CashierSessionsOpened", fields: [openedById], references: [id])
  closedBy        User?                 @relation("CashierSessionsClosed", fields: [closedById], references: [id])
  payments        Payment[]
  refunds         Refund[]
  counts          CashierSessionCount[]

  @@unique([hospitalId, sessionNo])
  @@index([hospitalId])
  @@index([status])
  @@index([openedAt])
}

/// One counted line per payment method on a closed session.
///
/// `expectedAmount` is stamped at close rather than recalculated on read, for
/// the same reason the tax rate is stamped on an invoice: a reconciliation
/// records what was found at the time, and must not drift if a payment is
/// corrected afterwards.
model CashierSessionCount {
  id              String         @id @default(cuid())
  sessionId       String
  paymentMethod   PaymentMethod

  expectedAmount  Decimal        @db.Decimal(10, 2)
  countedAmount   Decimal        @db.Decimal(10, 2)
  varianceAmount  Decimal        @db.Decimal(10, 2)
  notes           String?        @db.Text

  createdAt       DateTime       @default(now())

  session         CashierSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, paymentMethod])
  @@index([sessionId])
}

enum CashierSessionStatus {
  OPEN
  CLOSED
}

enum DiscountApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model InvoiceItem {
  id              String     @id @default(cuid())
  invoiceId       String
  treatmentId     String?

  description     String
  quantity        Int        @default(1)
  unitPrice       Decimal    @db.Decimal(10, 2)
  amount          Decimal    @db.Decimal(10, 2)
  taxable         Boolean    @default(true)

  createdAt       DateTime   @default(now())

  invoice         Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatment       Treatment? @relation(fields: [treatmentId], references: [id])
}

model Payment {
  id              String        @id @default(cuid())
  hospitalId      String
  paymentNo       String
  invoiceId       String

  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentDate     DateTime      @default(now())

  transactionId   String?
  bankName        String?
  chequeNumber    String?
  chequeDate      DateTime?
  upiId           String?

  notes           String?
  status          PaymentStatus @default(COMPLETED)

  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundDate      DateTime?
  refundReason    String?

  // FR-015, and spec §12 which names the cashier on a financial transaction.
  // A payment taken while a till is open belongs to that till's reconciliation.
  cashierSessionId String?
  recordedById    String?

  gateway           String?    // razorpay / phonepe / paytm
  gatewayOrderId    String?    // Provider's order/transaction ID
  gatewayPaymentId  String?    // Provider's payment ID
  gatewayStatus     String?    // Provider-reported status

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  cashierSession  CashierSession? @relation(fields: [cashierSessionId], references: [id])
  recordedBy      User?         @relation("PaymentsRecorded", fields: [recordedById], references: [id])
  refunds         Refund[]

  @@unique([hospitalId, paymentNo])
  @@index([hospitalId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([gatewayOrderId])
  @@index([cashierSessionId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  INSURANCE
  WALLET
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  // Some of the money has gone back but not all of it. Without this a payment
  // refunded in part had to be marked either COMPLETED (hiding the refund) or
  // REFUNDED (claiming the whole amount went back).
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

