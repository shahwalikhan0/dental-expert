/// Every message the clinic sent a patient, whatever it went out over.
///
/// This was three tables — `SMSLog`, `EmailLog` and `AppointmentReminder` —
/// carrying the same twenty columns three times over. They differed in four
/// fields between them and in nothing else: a subject line that only email has,
/// a per-message cost that only SMS has, and an open-tracking pixel. Reporting
/// on "how many messages did we send this patient" meant querying three tables
/// and stitching the results together, and adding WhatsApp would have meant a
/// fourth.
///
/// `AppointmentReminder` in particular recorded that a reminder was scheduled
/// but not what it said or whether it arrived, so a patient insisting they were
/// never reminded could be shown a row saying SENT and nothing else.
model MessageLog {
  id              String        @id @default(cuid())
  hospitalId      String
  channel         CommunicationChannel
  patientId       String?

  /// Where it went: a phone number for SMS and WhatsApp, an address for email.
  recipient       String
  /// Email only.
  subject         String?
  body            String        @db.Text

  templateId      String?

  /// What the message was about, so a reminder can be traced back to the
  /// appointment it was about and a receipt to its invoice.
  relatedType     String?
  relatedId       String?

  status          MessageStatus @default(PENDING)
  /// Which provider carried it — Twilio, an SMTP host, a WhatsApp gateway.
  provider        String?
  /// The provider's own id for the message, for chasing a delivery failure.
  providerRef     String?

  scheduledFor    DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  /// Email only, set by the tracking pixel.
  openedAt        DateTime?
  failedAt        DateTime?

  errorMessage    String?
  /// SMS only, and per message rather than per batch.
  cost            Decimal?      @db.Decimal(10, 4)

  /// The token in the tracking pixel's URL. Unique because it is looked up by
  /// an unauthenticated request.
  trackingId      String?       @unique

  metadata        Json?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  template        CommunicationTemplate? @relation(fields: [templateId], references: [id])

  @@index([relatedType, relatedId])
  @@index([hospitalId, channel, createdAt(sort: Desc)])
  @@index([hospitalId, patientId, createdAt(sort: Desc)])
  @@index([hospitalId, status, createdAt(sort: Desc)])
  @@index([status, scheduledFor])
}

enum TemplateCategory {
  APPOINTMENT
  PAYMENT
  BIRTHDAY
  PROMOTIONAL
  FOLLOW_UP
  LAB_WORK
  PRESCRIPTION
  GENERAL
}

enum CommunicationChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

