// ==================== INVENTORY MANAGEMENT ====================

model InventoryCategory {
  id              String    @id @default(cuid())
  hospitalId      String
  name            String
  description     String?
  parentId        String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  parent          InventoryCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        InventoryCategory[] @relation("CategoryHierarchy")
  items           InventoryItem[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model InventoryItem {
  id              String    @id @default(cuid())
  hospitalId      String
  sku             String
  name            String
  categoryId      String?
  description     String?   @db.Text
  itemType        InventoryItemType @default(DENTAL_MATERIAL)
  // Single "preferred supplier" pointer used by the item form and the
  // suppliers list's items-supplied count. Distinct from SupplierItem, which
  // records every supplier that stocks an item along with their SKU/price.
  preferredSupplierId String?

  unit            String
  currentStock    Int       @default(0)
  minimumStock    Int       @default(10)
  reorderLevel    Int       @default(20)
  maximumStock    Int?

  purchasePrice   Decimal   @db.Decimal(10, 2)
  sellingPrice    Decimal?  @db.Decimal(10, 2)
  hsnCode         String?
  taxPercentage   Decimal?  @db.Decimal(5, 2)

  imageUrl        String?
  notes           String?   @db.Text

  manufacturer    String?
  batchTracking   Boolean   @default(false)
  expiryTracking  Boolean   @default(false)

  storageLocation String?
  storageConditions String?

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  category        InventoryCategory? @relation(fields: [categoryId], references: [id])
  preferredSupplier Supplier? @relation("PreferredSupplierItems", fields: [preferredSupplierId], references: [id])
  stockTransactions StockTransaction[]
  batches         InventoryBatch[]
  supplierItems   SupplierItem[]
  alerts          StockAlert[]

  @@unique([hospitalId, sku])
  @@index([hospitalId])
  @@index([name])
  @@index([currentStock])
  @@index([deletedAt])
  @@index([itemType])
  @@index([preferredSupplierId])
}

enum InventoryItemType {
  DENTAL_MATERIAL
  INSTRUMENT
  CONSUMABLE
  MEDICINE
  OFFICE_SUPPLY
  EQUIPMENT
}

model InventoryBatch {
  id              String    @id @default(cuid())
  hospitalId      String
  itemId          String
  batchNumber     String
  quantity        Int
  remainingQty    Int
  purchasePrice   Decimal   @db.Decimal(10, 2)
  manufacturingDate DateTime?
  expiryDate      DateTime?
  supplierId      String?
  receivedDate    DateTime  @default(now())

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  stockTransactions StockTransaction[]

  @@index([hospitalId])
  @@index([itemId])
  @@index([expiryDate])
}

model StockTransaction {
  id              String               @id @default(cuid())
  hospitalId      String
  itemId          String
  type            StockTransactionType
  quantity        Int
  previousStock   Int
  newStock        Int
  batchNumber     String?

  batchId         String?
  supplierId      String?

  referenceType   String?
  referenceId     String?

  // Where stock moved between, for transfer transactions.
  fromLocation    String?
  toLocation      String?

  unitPrice       Decimal?             @db.Decimal(10, 2)
  totalPrice      Decimal?             @db.Decimal(10, 2)

  notes           String?
  performedBy     String?

  // When the movement happened, which is not always when the row was written
  // (back-dated stock takes, delayed goods-receipt entry).
  transactionDate DateTime             @default(now())
  createdAt       DateTime             @default(now())

  hospital        Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem        @relation(fields: [itemId], references: [id])
  batch           InventoryBatch?      @relation(fields: [batchId], references: [id])
  supplier        Supplier?            @relation(fields: [supplierId], references: [id])

  @@index([hospitalId])
  @@index([itemId])
  @@index([createdAt])
  @@index([transactionDate])
  @@index([type])
  @@index([batchId])
  @@index([supplierId])
}

enum StockTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
  EXPIRED
  RETURNED
  TRANSFERRED
  CONSUMPTION
}

model Supplier {
  id              String    @id @default(cuid())
  hospitalId      String
  code            String
  name            String
  contactPerson   String?
  email           String?
  phone           String
  alternatePhone  String?
  address         String?   @db.Text
  city            String?
  state           String?
  postalCode      String?
  taxRegistrationNo String?
  nationalTaxNo   String?
  bankAccountNo   String?
  bankIban        String?
  paymentTerms    String?
  creditLimit     Decimal?  @db.Decimal(12, 2)
  notes           String?   @db.Text
  rating          Int?      @default(0)
  isActive        Boolean   @default(true)
  // Three-state lifecycle carried over from the legacy `suppliers.status`
  // column. isActive is kept for backwards compatibility and mirrors
  // status != BLOCKED/INACTIVE.
  status          SupplierStatus @default(ACTIVE)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  batches         InventoryBatch[]
  supplierItems   SupplierItem[]
  preferredForItems InventoryItem[] @relation("PreferredSupplierItems")
  stockTransactions StockTransaction[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([name])
  @@index([status])
  @@index([deletedAt])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model SupplierItem {
  id              String    @id @default(cuid())
  supplierId      String
  itemId          String
  supplierSku     String?
  supplierPrice   Decimal   @db.Decimal(10, 2)
  leadTimeDays    Int?
  minimumOrderQty Int?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  item            InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([supplierId, itemId])
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  hospitalId      String
  orderNumber     String
  supplierId      String

  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  receivedDate    DateTime?

  subtotal        Decimal             @db.Decimal(10, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal             @db.Decimal(10, 2)

  status          PurchaseOrderStatus @default(DRAFT)
  notes           String?             @db.Text

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  items           PurchaseOrderItem[]

  @@unique([hospitalId, orderNumber])
  @@index([hospitalId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@index([deletedAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  itemId          String

  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Decimal       @db.Decimal(10, 2)
  amount          Decimal       @db.Decimal(10, 2)

  createdAt       DateTime      @default(now())

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Low-stock / expiry alerts raised against an inventory item.
/// Replaces the legacy `stock_alerts` table that app/api/inventory/alerts
/// queried directly; that table was never part of this schema, so the route
/// only ever worked on machines where the out-of-repo inventory SQL had been
/// applied by hand.
model StockAlert {
  id              String         @id @default(cuid())
  hospitalId      String
  itemId          String

  alertType       StockAlertType
  alertDate       DateTime       @default(now())

  isAcknowledged  Boolean        @default(false)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?

  notes           String?        @db.Text

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  acknowledgedByUser User?       @relation(fields: [acknowledgedBy], references: [id])

  @@index([hospitalId])
  @@index([itemId])
  @@index([alertType])
  @@index([isAcknowledged])
  @@index([alertDate])
}

enum StockAlertType {
  OUT_OF_STOCK
  LOW_STOCK
  EXPIRING_SOON
  EXPIRED
}

// ==================== LAB WORK MANAGEMENT ====================

model LabVendor {
  id              String    @id @default(cuid())
  hospitalId      String
  code            String?
  name            String
  contactPerson   String?
  phone           String
  alternatePhone  String?
  email           String?
  address         String?   @db.Text
  city            String?
  state           String?
  postalCode      String?
  taxRegistrationNo String?
  nationalTaxNo   String?
  specializations String?   @db.Text
  avgTurnaround   Int?
  rating          Int?      @default(0)
  paymentTerms    String?
  creditLimit     Decimal?  @db.Decimal(12, 2)
  notes           String?   @db.Text
  isActive        Boolean   @default(true)
  status          LabVendorStatus @default(ACTIVE)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  labOrders       LabOrder[]

  @@index([hospitalId])
  @@index([status])
  @@index([deletedAt])
}

enum LabVendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model LabOrder {
  id              String         @id @default(cuid())
  hospitalId      String
  orderNumber     String
  patientId       String
  labVendorId     String

  workType        LabWorkType
  description     String?        @db.Text
  toothNumbers    String?
  shadeGuide      String?

  orderDate       DateTime       @default(now())
  expectedDate    DateTime?
  sentDate        DateTime?
  receivedDate    DateTime?
  deliveredDate   DateTime?

  estimatedCost   Decimal        @db.Decimal(10, 2)
  actualCost      Decimal?       @db.Decimal(10, 2)

  status          LabOrderStatus @default(CREATED)
  priority        LabOrderPriority @default(NORMAL)
  qualityCheck    QualityCheckStatus?
  qualityNotes    String?

  notes           String?        @db.Text
  specialInstructions String?    @db.Text
  createdBy       String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id])
  labVendor       LabVendor      @relation(fields: [labVendorId], references: [id])
  history         LabOrderHistory[]
  documents       LabOrderDocument[]

  @@unique([hospitalId, orderNumber])
  @@index([hospitalId])
  @@index([patientId])
  @@index([status])
  @@index([orderDate])
  @@index([deletedAt])
