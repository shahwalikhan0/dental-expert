// Dental Hospital Management System - Database Schema
// Multi-Tenant SaaS Architecture

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== MULTI-TENANCY ====================

model Hospital {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  email               String    @unique
  phone               String?
  alternatePhone      String?
  address             String?   @db.Text
  city                String?
  state               String?
  // "PIN code" is India's term; Pakistan Post calls it a postal code.
  postalCode          String?
  logo                String?
  registrationNo      String?
  // Tax identifiers. Renamed from the Indian gstNumber/panNumber: Pakistan
  // issues an STRN for sales-tax registration and an NTN for income tax.
  taxRegistrationNo   String?
  nationalTaxNo       String?
  // Sales tax on services, off by default because dental services are exempt
  // for this clinic. Turning it on is a settings change, not a migration:
  // set taxEnabled, a rate and the label to print on invoices.
  taxEnabled          Boolean   @default(false)
  taxRate             Decimal   @default(0) @db.Decimal(5, 2)
  taxLabel            String    @default("Sales Tax")
  website             String?
  tagline             String?

  // Localization. `country` will select the tax provider — see
  // docs/LOCALIZATION.md. All four defaults are Pakistan: leaving three of them
  // on Indian values while `locale` said en-PK meant a clinic created without
  // an explicit setting billed in rupees on Kolkata time.
  locale              String    @default("en-PK")
  country             String    @default("PK")
  currency            String    @default("PKR")
  timezone            String    @default("Asia/Karachi")

  // What this tenant is paying for lives on Subscription, not here. It used to
  // be five columns on this row — a plan name and three copied-down limits —
  // which meant raising a plan's allowance left every clinic already signed up
  // on the old numbers for ever. See lib/plans.ts.

  // Suspension by the platform, as opposed to by billing: fraud, abuse, or a
  // tenant who asked to be switched off. A lapsed subscription is a separate
  // state and is read from Subscription.status.
  isActive            Boolean   @default(true)
  onboardingCompleted Boolean   @default(false)

  emailVerificationToken  String?
  emailVerificationExpiry DateTime?

  workingHours        String?   @db.Text
  bankName            String?
  bankAccountNo       String?
  bankAccountName     String?
  // IBAN, not an IFSC code: IFSC is India's bank routing identifier. Pakistani
  // accounts are identified by a 24-character IBAN (PK + 2 check digits + 4
  // bank code + 16 account number).
  bankIban            String?
  /// A mobile-money number to print on an invoice — JazzCash or Easypaisa.
  /// Was `upiId`, which is India's rail and has no Pakistani equivalent that
  /// the bank fields above do not already cover.
  mobileWalletId      String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  users               User[]
  staff               Staff[]
  patients            Patient[]
  appointments        Appointment[]
  visitors            Visitor[]
  recareTypes         RecareType[]
  recares             Recare[]
  perioExams          PerioExam[]
  refunds             Refund[]
  cashierSessions     CashierSession[]
  treatmentAmendments TreatmentAmendment[]
  treatments          Treatment[]
  treatmentPlans      TreatmentPlan[]
  dentalChartEntries  DentalChartEntry[]
  prescriptions       Prescription[]
  procedures          Procedure[]
  medications         Medication[]
  invoices            Invoice[]
  payments            Payment[]
  inventoryItems      InventoryItem[]
  inventoryBatches    InventoryBatch[]
  stockTransactions   StockTransaction[]
  stockAlerts         StockAlert[]
  vendors             Vendor[]
  purchaseOrders      PurchaseOrder[]
  labOrders           LabOrder[]
  documents           Document[]
  auditLogs           AuditLog[]
  settings            Setting[]
  documentCounters    DocumentCounter[]
  communicationTemplates CommunicationTemplate[]
  messageLogs         MessageLog[]
  availability        Availability[]
  patientPortalEnabled Boolean   @default(false)

  formTemplates       FormTemplate[]
  formSubmissions     FormSubmission[]
  waitlistEntries     Waitlist[]
  dataImportJobs      DataImportJob[]
  subscription        Subscription?

  @@index([slug])
  @@index([isActive])
}

/// The tiers on offer. What each one *allows* is in lib/plans.ts, not here:
/// an enum value is a name, and pricing and allowances change far more often
/// than the set of tiers does — a limit in the database would need a migration
/// every time marketing changed its mind.
enum Plan {
  FREE
  PROFESSIONAL
  ENTERPRISE
  SELF_HOSTED
}

// ==================== SUBSCRIPTION & BILLING ====================

/// What a tenant is paying for, and until when.
///
/// One row per clinic, created with the clinic. Access is judged against
/// `status` and `currentPeriodEnd` rather than a flag somebody has to remember
/// to flip: a subscription that has simply run out stops being ACTIVE on its
/// own, which is the failure mode you want when nobody is watching.
model Subscription {
  id                 String             @id @default(cuid())
  hospitalId         String             @unique
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(TRIALING)

  /// The window the tenant has paid for. `currentPeriodEnd` is NULL for plans
  /// that do not expire — Free, and the perpetual Self-Hosted licence.
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?

  /// Set when a tenant asks to stop. The subscription still runs to the end of
  /// the period they paid for; cancelling is not the same as expiring, and a
  /// clinic that has paid until March should not lose its records in January.
  cancelRequestedAt  DateTime?
  cancelledAt        DateTime?

  /// Negotiated exceptions to the plan's allowances. NULL — the normal case —
  /// means "whatever the plan says", so raising a plan's limits raises them for
  /// everyone on it. A number here is a deal somebody agreed on purpose.
  patientLimitOverride   Int?
  staffLimitOverride     Int?
  storageLimitMbOverride Int?

  /// Free-text note from the platform side: who agreed what, and when.
  note               String?            @db.Text

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  hospital           Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
}

enum SubscriptionStatus {
  /// Full access, no payment taken yet.
  TRIALING
  ACTIVE
  /// Payment is late. Still working — the clinic's day does not stop because
  /// an invoice is overdue — but the warning is showing.
  PAST_DUE
  /// Switched off by the platform. Staff may still sign in and read and export
  /// their data; they may not write. Deliberately not deletion: a clinic's
  /// records are not ours to destroy over an unpaid bill.
  SUSPENDED
  CANCELLED
}

// ==================== AUTHENTICATION & USERS ====================

model User {
  id              String    @id @default(cuid())
  hospitalId      String
  /// Unique **within a clinic**, not across the platform — see the compound
  /// index at the bottom of this model. A globally unique address meant a
  /// dentist who works Tuesdays at one practice and Thursdays at another could
  /// not have an account at both, and that the second clinic to try got told
  /// "an account with this email already exists" about a clinic they cannot
  /// see and have nothing to do with.
  email           String
  /// Null while this row is an invitation rather than an account. An invited
  /// person exists here from the moment they are invited — same clinic, same
  /// email uniqueness, same row they will go on using — but holds no password,
  /// no Staff record and `isActive: false`, so nothing can sign in as them and
  /// they appear nowhere a member of staff appears. Accepting the invitation
  /// sets the password and clears the token below; there is no second table.
  password        String?
  name            String
  phone           String?
  role            Role      @default(RECEPTIONIST)
  // Optional second role, for the person who holds two jobs — most often the
  // owner who also treats patients. Permissions become the union of the two.
  //
  // This exists because `role` alone forces a false choice on that person:
  // ADMIN deliberately cannot sign a clinical note (FR-007 wants a signature
  // to attest as the treating provider), so an owner-dentist with a single
  // ADMIN account could not sign their own work. Only clinical roles are
  // assignable here — see SECONDARY_ROLES in lib/rbac.ts.
  clinicalRole    Role?
  isActive        Boolean   @default(true)
  isHospitalAdmin Boolean   @default(false)
  /// Staff of the platform itself, not of any clinic — the people who onboard
  /// tenants, change plans and suspend accounts. Deliberately a flag on an
  /// ordinary user rather than a Role: platform administration is orthogonal to
  /// what someone may do *inside* a clinic, and modelling it as a ninth role
  /// would have meant every clinic-side permission table growing a column for a
  /// role that never appears in a clinic.
  isPlatformAdmin Boolean   @default(false)
  emailVerified   DateTime?
  image           String?
  mustChangePassword Boolean @default(false)
  /// When the password was last set, for the expiry in Settings → Security.
  ///
  /// Backfilled to the moment the column was added rather than to `createdAt`.
  /// The real date is not recoverable — nothing recorded it — and treating
  /// every existing password as being as old as its account would have expired
  /// a whole clinic at once, on deploy, for a policy that was off until that
  /// same release. The clock starts when the policy became real.
  passwordChangedAt DateTime?

  // Personal locale override, BCP 47. NULL means "inherit from the clinic" and
  // is deliberately NOT defaulted: a default would be indistinguishable from an
  // explicit choice of en-IN, so a clinic changing its own locale would
  // silently fail to propagate to every staff member who never expressed a
  // preference. See docs/LOCALIZATION.md.
  locale          String?

  /// The outstanding invitation, when this row is one. Cleared on acceptance,
  /// so a non-null token is what makes the row an invitation and a lookup by
  /// token cannot reach an account that has already been claimed.
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  invitedById     String?

  /// An outstanding password reset.
  ///
  /// Same shape as the invitation above and for the same reason: no second
  /// table, and a lookup by token cannot reach an account whose reset has been
  /// used, because using it clears the token. Unique so that two people cannot
  /// hold the same link, and so the lookup is an index hit rather than a scan.
  ///
  /// An account may hold a reset and an invitation at once — a person invited
  /// to a second clinic who forgets their password at the first — so these are
  /// deliberately separate columns rather than one reused pair.
  resetToken      String?   @unique
  resetExpiresAt  DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff           Staff?
  invitedBy       User?     @relation("StaffInvitations", fields: [invitedById], references: [id], onDelete: SetNull)
  invitationsSent User[]    @relation("StaffInvitations")
  auditLogs       AuditLog[]
  dataImportJobs  DataImportJob[]
  acknowledgedStockAlerts StockAlert[]
  discountsRequested      Invoice[]        @relation("DiscountsRequested")
  discountsApproved       Invoice[]        @relation("DiscountsApproved")
  refundsAuthorised       Refund[]         @relation("RefundsAuthorised")
  paymentsRecorded        Payment[]        @relation("PaymentsRecorded")
  cashierSessionsOpened   CashierSession[] @relation("CashierSessionsOpened")
  cashierSessionsClosed   CashierSession[] @relation("CashierSessionsClosed")
  treatmentsSigned        Treatment[]          @relation("TreatmentsSigned")
  chartEntriesRecorded    DentalChartEntry[]   @relation("ChartEntriesRecorded")
  perioExamsRecorded      PerioExam[]          @relation("PerioExamsRecorded")
  visitorsConverted       Visitor[]            @relation("VisitorsConverted")
  visitorsDiscarded       Visitor[]            @relation("VisitorsDiscarded")
  treatmentAmendments     TreatmentAmendment[] @relation("TreatmentAmendments")

  @@unique([hospitalId, email])
  @@index([email])
  @@index([role])
  @@index([hospitalId])
  @@index([isPlatformAdmin])
}

// The seven roles of specification §4, plus LAB_TECH for the dental-laboratory
// coordination of §5.8. Spec name -> enum value:
//
//   System Administrator  -> ADMIN
//   Clinic Manager        -> CLINIC_MANAGER
//   Dentist               -> DOCTOR
//   Dental Assistant      -> DENTAL_ASSISTANT
//   Front Desk/Reception  -> RECEPTIONIST
//   Accounts/Cashier      -> ACCOUNTANT
//   Inventory/Store       -> INVENTORY_STAFF
//
// What each one may actually do lives in lib/rbac.ts, not here. Adding a value
// to this enum grants nothing on its own.
enum Role {
  ADMIN
  CLINIC_MANAGER
  DOCTOR
  DENTAL_ASSISTANT
  RECEPTIONIST
  ACCOUNTANT
  INVENTORY_STAFF
  LAB_TECH
}

// ==================== STAFF INVITES ====================

// ==================== STAFF MANAGEMENT ====================

model Staff {
  id              String    @id @default(cuid())
  hospitalId      String
  userId          String    @unique
  employeeId      String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  phone           String
  alternatePhone  String?
  email           String
  address         String?   @db.Text
  city            String?
  state           String?
  postalCode      String?
  // Pakistan's national identity number. Aadhaar is India's, 12 digits;
  // a CNIC is 13, issued by NADRA. Stored as digits only and formatted
  // 00000-0000000-0 for display — see lib/cnic.ts.
  cnic            String?
  nationalTaxNo   String?
  qualification   String?
  specialization  String?
  licenseNumber   String?
  joiningDate     DateTime  @default(now())
  /// Payroll is out of scope — spec §3 excludes "full payroll, attendance, or
  /// enterprise HR management beyond basic user/staff profiles". `salary`,
  /// `bankAccountNo` and `bankIban` lived here, and the staff form collected
  /// them, for a feature nobody was going to build.
  emergencyContact String?
  emergencyPhone  String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments    Appointment[] @relation("DoctorAppointments")
  treatments      Treatment[]
  prescriptions   Prescription[]
  availability    Availability[]

  @@unique([hospitalId, employeeId])
  // One person, one CNIC. PostgreSQL treats NULLs as distinct in a unique
  // index, so the many staff without one recorded do not collide.
  @@unique([hospitalId, cnic])
  @@index([hospitalId, isActive, lastName])
}

model Availability {
  id          String    @id @default(cuid())
  hospitalId  String

  /// Null means the clinic as a whole; set means this one person. A clinic
  /// closing for Eid and a dentist taking the Tuesday off are the same fact at
  /// different scopes, and the slot picker has to consult both.
  staffId     String?

  /// Exactly one of these is set, enforced by a CHECK constraint the migration
  /// adds: `dayOfWeek` (0 = Sunday) for something that repeats every week, or
  /// `date` for one particular day.
  dayOfWeek   Int?
  date        DateTime? @db.Date

  /// `HH:MM` on the clinic's own wall clock. Null on both means the whole day,
  /// which is what a clinic holiday is — and what a day of leave is, something
  /// neither of the two tables this replaces could express.
  startTime   String?
  endTime     String?

  /// Whether this opens the time or closes it. A weekly shift opens it; a
  /// holiday or a day of leave closes it.
  isAvailable Boolean   @default(true)

  /// What to call it on a screen: "Eid al-Fitr", "Annual leave".
  name        String?

  /// A dated entry that comes round every year. The holiday table had this
  /// column and nothing read it, so a recurring holiday was observed once.
  isRecurring Boolean   @default(false)

  createdAt   DateTime  @default(now())

  hospital    Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff       Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([hospitalId, staffId, dayOfWeek])
  @@index([hospitalId, date])
  @@index([hospitalId, isRecurring])
}

// ==================== PATIENT MANAGEMENT ====================

model Patient {
  id              String     @id @default(cuid())
  hospitalId      String
  patientId       String
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  /// `age Int?` was here, written once at registration and never again — so it
  /// was wrong for most of the year, and the analytics report already ignored
  /// it and computed age from `dateOfBirth`. See lib/age.ts.
  gender          Gender?
  bloodGroup      BloodGroup?
  phone           String
  alternatePhone  String?
  email           String?
  address         String?    @db.Text
  city            String?
  // No default: the upstream schema defaulted this to "Tamil Nadu", which
  // silently stamped an Indian state onto every Pakistani patient. There is no
  // right default — the clinic's own province is a guess for anyone who
  // travelled in — so it is left blank.
  state           String?
  postalCode      String?
  // See the note on Staff.cnic. Children are issued a B-Form rather than a
  // CNIC, so this is nullable and stays that way.
  cnic            String?
  occupation      String?
  referredBy      String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?

  // Locale override for the patient portal. NULL means "inherit from the
  // clinic" — same reasoning as User.locale above.
  locale          String?

  /// How this patient wants to be contacted, and about what.
  ///
  /// Was a fifteen-column table with one row per patient — except that nothing
  /// ever created a row, so every patient had no preferences at all, and the
  /// SMS service read `!preference?.smsEnabled` and refused to send to anybody.
  /// Defaults now live in lib/communication-preferences.ts and apply to a
  /// patient who has never expressed one, which is almost all of them.
  communicationPrefs Json?

  aiSummary       Json?
  aiSummaryAt     DateTime?

  isActive        Boolean    @default(true)

  /// Set when this record was merged into another as a duplicate.
  ///
  /// The loser of a merge is kept, deactivated, rather than deleted. Its
  /// patient ID has been written on paper — on a prescription, a receipt, a lab
  /// docket — and a clinic that looks it up afterwards should be told where the
  /// record went, not shown nothing. Everything clinical has already moved to
  /// the surviving record by the time this is set.
  mergedIntoId    String?
  mergedAt        DateTime?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  hospital        Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  mergedInto      Patient?   @relation("PatientMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom      Patient[]  @relation("PatientMerge")
  medicalHistory  MedicalHistory?
  appointments    Appointment[]
  treatments      Treatment[]
  treatmentPlans  TreatmentPlan[]
  dentalChart     DentalChartEntry[]
  recares         Recare[]
  perioExams      PerioExam[]
  convertedFrom   Visitor[]          @relation("VisitorConvertedTo")
  prescriptions   Prescription[]
  invoices        Invoice[]
  documents       Document[]
  labOrders       LabOrder[]

  @@unique([hospitalId, patientId])
  // FR-002 duplicate prevention. A CNIC identifies one person, so two patient
  // records carrying the same one are the same patient twice. NULLs stay
  // distinct, which matters: children hold a B-Form, not a CNIC.
  @@unique([hospitalId, cnic])
  @@index([hospitalId, createdAt(sort: Desc)])
  @@index([hospitalId, isActive, createdAt(sort: Desc)])
  @@index([hospitalId, phone])
  @@index([hospitalId, lastName, firstName])
}

/// What a clinician needs to know before picking up a handpiece.
///
/// This was thirty-four columns: sixteen `hasX` booleans, each with an optional
/// `xType` beside it for the two or three that had one, and a catch-all
/// `otherConditions` for everything the list did not anticipate. Which was a
/// lot — a patient on warfarin, a transplant recipient, anyone on a bisphosphonate
/// — all of whom matter more to a dental procedure than several of the things
/// that did get a column.
///
/// Three lists instead. A condition is still perfectly queryable (`conditions`
/// `has` 'Diabetes'), and it can now record something nobody thought of when
/// the schema was written. lib/medical-history.ts holds the list the form
/// offers, so the common ones stay spelled consistently.
///
/// The habits and the dental-specific fields keep their own columns: they are
/// answers to fixed questions with fixed ranges, not an open list.
model MedicalHistory {
  id                 String    @id @default(cuid())
  patientId          String    @unique

  /// Drugs, foods, materials — latex and local anaesthetic belong here as much
  /// as penicillin does, and separating them into three columns meant a
  /// clinician had to read three fields to find out what not to use.
  allergies          String[]
  /// Ongoing medical conditions, in the clinic's own words.
  conditions         String[]
  currentMedications String[]

  /// Its own field rather than a condition: it is temporary, it has a number
  /// attached, and it changes what may be prescribed and radiographed today.
  isPregnant         Boolean   @default(false)
  pregnancyWeeks     Int?

  smokingStatus      SmokingStatus      @default(NEVER)
  alcoholConsumption AlcoholConsumption @default(NEVER)
  tobaccoChewing     Boolean            @default(false)

  previousDentalWork  String?  @db.Text
  lastDentalVisit     DateTime?
  /// 0-10. Drives how much time to allow and whether to offer sedation.
  dentalAnxietyLevel  Int?     @default(0)
  familyDentalHistory String?  @db.Text

  additionalNotes    String?   @db.Text

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
  OCCASIONAL
}

enum AlcoholConsumption {
  NEVER
  OCCASIONAL
  MODERATE
  HEAVY
}

// ==================== APPOINTMENT SCHEDULING ====================

model Appointment {
  id              String            @id @default(cuid())
  hospitalId      String
  appointmentNo   String

  /// Exactly one of these is set — see the CHECK constraint in the migration.
  /// A walk-in is a `Visitor` until somebody decides to register them, which is
  /// the whole point: the desk should not have to invent a patient record for
  /// someone who may never come back.
  patientId       String?
  visitorId       String?
  doctorId        String

  /// The instant the appointment starts, in UTC. A clinic books a wall-clock
  /// time ("Thursday at 15:00"), which the API converts against the clinic's
  /// own timezone on the way in and renders back on the way out — but what is
  /// stored is a point in time, so "an hour before" is arithmetic rather than a
  /// reassembly of a date column and a free-text string.
  startsAt        DateTime          @db.Timestamptz(3)
  duration        Int               @default(30)

  /// The queue number for the day, as DDMMYY then a three-digit sequence —
  /// 200926001 is the first arrival on 20 September 2026. Issued on check-in
  /// and not before: a number handed out at booking says nothing about who is
  /// waiting, and the queue a clinic actually runs is arrival order.
  tokenNumber     String?
  tokenIssuedAt   DateTime?

  appointmentType AppointmentType   @default(CONSULTATION)
  status          AppointmentStatus @default(SCHEDULED)
  priority        Priority          @default(NORMAL)

  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  waitTime        Int?

  chiefComplaint  String?           @db.Text
  notes           String?           @db.Text

  cancelledAt     DateTime?
  cancellationReason String?

  /// Booked by the patient on the public page, rather than by the desk.
  ///
  /// The booking route used to rely on `status: SCHEDULED` to mean "nobody at
  /// the clinic has seen this yet" — but the desk's own bookings are SCHEDULED
  /// too, so the two were indistinguishable. Meanwhile the confirmation page
  /// tells the patient "the clinic will telephone you to confirm", which is a
  /// promise the software gave nobody the means to keep.
  bookedOnline    Boolean           @default(false)

  /// When somebody at the desk first dealt with it. Null on an online booking
  /// nobody has looked at, which is what the review queue is built from.
  reviewedAt      DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient?          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  visitor         Visitor?          @relation(fields: [visitorId], references: [id], onDelete: Restrict)
  doctor          Staff             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  treatments      Treatment[]

  @@unique([hospitalId, appointmentNo])
  @@unique([hospitalId, tokenNumber])
  @@index([hospitalId, startsAt])
  @@index([hospitalId, status, startsAt])
  @@index([hospitalId, doctorId, startsAt])
  @@index([hospitalId, patientId, startsAt(sort: Desc)])
  @@index([hospitalId, visitorId])
  /// The desk's "what came in overnight" list: online, not yet looked at.
  @@index([hospitalId, bookedOnline, reviewedAt])
}



enum AppointmentType {
  CONSULTATION
  PROCEDURE
  FOLLOW_UP
  EMERGENCY
  CHECK_UP
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}



// ==================== DENTAL CHART ====================

model DentalChartEntry {
  id              String         @id @default(cuid())
  hospitalId      String
  patientId       String
  toothNumber     Int
  toothNotation   String

  mesial          Boolean        @default(false)
  distal          Boolean        @default(false)
  occlusal        Boolean        @default(false)
  buccal          Boolean        @default(false)
  lingual         Boolean        @default(false)

  condition       ToothCondition
  severity        Severity       @default(MILD)

  notes           String?
  diagnosedDate   DateTime       @default(now())
  resolvedDate    DateTime?

  // Who charted this. A finding on a tooth is a clinical record, and UAT-04
  // asks for the encounter to be saved "with author/date": the date was here
  // from the start, the author was not recorded anywhere at all. Nullable
  // because entries charted before this column existed have no author to name,
  // and guessing one would be worse than admitting the gap.
  recordedById    String?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient        @relation(fields: [patientId], references: [id])
  recordedBy      User?          @relation("ChartEntriesRecorded", fields: [recordedById], references: [id])

  @@index([hospitalId, patientId, toothNumber])
  @@index([recordedById])
}

enum ToothCondition {
  HEALTHY
  CARIES
  FILLED
  CROWN
  BRIDGE
  IMPLANT
  ROOT_CANAL
  EXTRACTION
  MISSING
  FRACTURED
  SENSITIVE
  MOBILITY
  ABSCESS
  PERIODONTAL
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

// ==================== TREATMENT & CLINICAL ====================

model Procedure {
  id              String            @id @default(cuid())
  hospitalId      String
  code            String
  name            String
  category        ProcedureCategory
  description     String?           @db.Text
  defaultDuration Int               @default(30)
  basePrice       Decimal           @db.Decimal(10, 2)

  materials       String?           @db.Text

  preInstructions String?           @db.Text
  postInstructions String?          @db.Text

  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital        Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatments      Treatment[]
  treatmentPlanItems TreatmentPlanItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive, category])
}

enum ProcedureCategory {
  PREVENTIVE
  RESTORATIVE
  ENDODONTIC
  PERIODONTIC
  PROSTHODONTIC
  ORTHODONTIC
  ORAL_SURGERY
  COSMETIC
  DIAGNOSTIC
  EMERGENCY
}

model TreatmentPlan {
  id              String              @id @default(cuid())
  hospitalId      String
  planNumber      String
  patientId       String

  title           String
  description     String?             @db.Text
  status          TreatmentPlanStatus @default(DRAFT)

  estimatedCost   Decimal             @db.Decimal(10, 2)
  estimatedDuration Int?

  startDate       DateTime?
  expectedEndDate DateTime?
  completedDate   DateTime?

  consentGiven    Boolean             @default(false)
  consentDate     DateTime?

  notes           String?             @db.Text

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient             @relation(fields: [patientId], references: [id])
  items           TreatmentPlanItem[]

  @@unique([hospitalId, planNumber])
  @@index([hospitalId, status, createdAt(sort: Desc)])
  @@index([hospitalId, patientId, createdAt(sort: Desc)])
}

model TreatmentPlanItem {
  id              String                  @id @default(cuid())
  treatmentPlanId String
  procedureId     String

  toothNumbers    String?
  priority        Int                     @default(1)
  estimatedCost   Decimal                 @db.Decimal(10, 2)
  status          TreatmentPlanItemStatus @default(PENDING)

  notes           String?

  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  treatmentPlan   TreatmentPlan           @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedure       Procedure               @relation(fields: [procedureId], references: [id])

  @@index([treatmentPlanId])
}

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentPlanItemStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Treatment {
  id              String          @id @default(cuid())
  hospitalId      String
  treatmentNo     String
  patientId       String
  appointmentId   String?
  procedureId     String
  doctorId        String

  toothNumbers    String?
  chiefComplaint  String?         @db.Text
  diagnosis       String?         @db.Text
  findings        String?         @db.Text
  procedureNotes  String?         @db.Text

  materialsUsed   String?         @db.Text

  status          TreatmentStatus @default(IN_PROGRESS)
  startTime       DateTime?
  endTime         DateTime?

  complications   String?         @db.Text

  followUpRequired Boolean        @default(false)
  followUpDate    DateTime?
  followUpNotes   String?

  cost            Decimal         @db.Decimal(10, 2)

  // FR-007: "Completed/signed notes must be locked or version-controlled with
  // audit history for later amendments."
  //
  // There is no separate `isLocked`: signed *is* locked, and a second flag is
  // one more thing that can disagree with the first. `COMPLETED` is a workflow
  // status, not an attestation — a note is only signed when a clinician puts
  // their name to it.
  signedById      String?
  signedAt        DateTime?
  // Set the first time a signed note is amended, so a reader can see at a
  // glance that what they are looking at is not what was originally signed.
  amendedAt       DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  hospital        Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient         @relation(fields: [patientId], references: [id])
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  procedure       Procedure       @relation(fields: [procedureId], references: [id])
  doctor          Staff           @relation(fields: [doctorId], references: [id])
  signedBy        User?           @relation("TreatmentsSigned", fields: [signedById], references: [id])
  amendments      TreatmentAmendment[]
  invoiceItems    InvoiceItem[]
  documents       Document[]

  @@unique([hospitalId, treatmentNo])
  @@index([hospitalId, status, createdAt(sort: Desc)])
  @@index([hospitalId, patientId, createdAt(sort: Desc)])
  @@index([hospitalId, doctorId, createdAt(sort: Desc)])
  @@index([appointmentId])
}

/// What was said, or corrected, about a clinical note after it was signed.
///
/// FR-007 wants signed notes locked "or version-controlled with audit history
/// for later amendments". There are two kinds of later amendment and they are
/// not the same act:
///
///  - an **addendum** adds something further. The signed note is not touched.
///    This is the normal way to say more about a treatment.
///  - a **correction** fixes a wrong value in a structured field. An addendum
///    cannot do this: a note recording tooth 26 when the work was on 27 leaves
///    every report on tooth 26 wrong, and a paragraph saying so does not fix
///    the data. So a signed note *can* be corrected, by a clinician, with a
///    reason — and `changes` records what it said beforehand.
///
/// They were two tables. They are one because they are the same row with one
/// field swapped, they are always read together in one chronological list, and
/// keeping them apart meant every reader of a signed note ran two queries and
/// merge-sorted the results by date.
///
/// Append-only either way: once written, an amendment cannot be edited or
/// removed. That is the whole point of it.
model TreatmentAmendment {
  id              String        @id @default(cuid())
  hospitalId      String
  treatmentId     String

  kind            AmendmentKind

  /// What the clinician wrote. For an addendum this is the addition itself;
  /// for a correction it is the reason the correction was needed.
  body            String        @db.Text

  /// Corrections only: `{ field: { from, to } }` for each field changed.
  changes         Json?

  authorId        String
  createdAt       DateTime      @default(now())

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  treatment       Treatment     @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  author          User          @relation("TreatmentAmendments", fields: [authorId], references: [id])

  @@index([hospitalId])
  @@index([treatmentId])
  @@index([kind])
}

enum AmendmentKind {
  ADDENDUM
  CORRECTION
}

enum TreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Prescription {
  id              String       @id @default(cuid())
  hospitalId      String
  prescriptionNo  String
  patientId       String
  doctorId        String

  diagnosis       String?
  notes           String?      @db.Text

  validUntil      DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id])
  doctor          Staff        @relation(fields: [doctorId], references: [id])
  medications     PrescriptionMedication[]

  @@unique([hospitalId, prescriptionNo])
  @@index([hospitalId, createdAt(sort: Desc)])
  @@index([hospitalId, patientId, createdAt(sort: Desc)])
  @@index([hospitalId, doctorId])
}

model PrescriptionMedication {
  id              String        @id @default(cuid())
  prescriptionId  String
  medicationId    String?

  medicationName  String
  dosage          String
  frequency       String
  duration        String
  route           String        @default("Oral")
  timing          String?
  quantity        Int?
  instructions    String?

  createdAt       DateTime      @default(now())

  prescription    Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication      Medication?   @relation(fields: [medicationId], references: [id])
}

model Medication {
  id              String       @id @default(cuid())
  hospitalId      String
  name            String
  genericName     String?
  category        String?
  form            String?
  strength        String?
  manufacturer    String?
  defaultDosage   String?
  defaultFrequency String?
  defaultDuration String?
  contraindications String?    @db.Text
  sideEffects     String?      @db.Text
  isActive        Boolean      @default(true)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescriptionMedications PrescriptionMedication[]

  @@index([hospitalId, isActive, name])
}

// ==================== BILLING & FINANCIAL ====================

model Invoice {
  id              String        @id @default(cuid())
  hospitalId      String
  invoiceNo       String
  patientId       String

  subtotal        Decimal       @db.Decimal(10, 2)
  discountType    DiscountType?
  discountValue   Decimal?      @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)

  // FR-013: a discount over the clinic's threshold needs a reason and an
  // approver who is not the person raising the invoice. Reception holds
  // `billing:write` but not `billing:discount`, so their request sits PENDING
  // and the invoice cannot leave DRAFT until a manager decides.
  discountReason         String?                @db.Text
  discountApprovalStatus DiscountApprovalStatus @default(NOT_REQUIRED)
  discountRequestedById  String?
  discountApprovedById   String?
  discountDecidedAt      DateTime?
  discountDecisionNote   String?                @db.Text
  taxableAmount   Decimal       @db.Decimal(10, 2)
  // One tax line, stamped onto the invoice at the moment it is raised.
  //
  // Upstream carried India's two-component split (CGST + SGST at 9% each).
  // Pakistan levies a single provincial sales tax on services, and dental
  // services are exempt for this clinic — hence the 0 default. The rate lives
  // on the invoice rather than being read from settings at display time so
  // that reprinting an old invoice shows the tax that was actually charged,
  // not today's rate.
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  balanceAmount   Decimal       @db.Decimal(10, 2)

  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?

  notes           String?       @db.Text
  termsAndConditions String?    @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id])
  items           InvoiceItem[]
  payments        Payment[]
  discountRequestedBy User?     @relation("DiscountsRequested", fields: [discountRequestedById], references: [id])
  discountApprovedBy  User?     @relation("DiscountsApproved", fields: [discountApprovedById], references: [id])

  @@unique([hospitalId, invoiceNo])
  @@index([hospitalId, status, createdAt(sort: Desc)])
  @@index([hospitalId, patientId, createdAt(sort: Desc)])
}

/// FR-014 — "Record refund amount, method, reason, authorizer, and link to
/// original transaction."
///
/// A refund is its own transaction, not an edit of the payment it reverses.
/// The previous implementation mutated `Payment.refundAmount` in place, which
/// recorded no authoriser, could not express a refund paid back by a different
/// method than it came in, and refused any second refund — so a partial refund
/// could never be followed by another.
model Refund {
  id              String        @id @default(cuid())
  hospitalId      String
  refundNo        String
  paymentId       String

  amount          Decimal       @db.Decimal(10, 2)
  /// May differ from the original payment: card takings are often refunded in
  /// cash, and the till reconciliation has to see the outflow under the method
  /// the money actually left by.
  refundMethod    PaymentMethod
  reason          String        @db.Text
  authorisedById  String
  cashierSessionId String?

  transactionId   String?
  refundedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  payment         Payment         @relation(fields: [paymentId], references: [id])
  authorisedBy    User            @relation("RefundsAuthorised", fields: [authorisedById], references: [id])
  cashierSession  CashierSession? @relation(fields: [cashierSessionId], references: [id])

  @@unique([hospitalId, refundNo])
  @@index([hospitalId, refundedAt(sort: Desc)])
  @@index([paymentId])
  @@index([cashierSessionId])
}

/// FR-015 — "Provide daily cashier/payment-method reconciliation and variance
/// record."
///
/// A till: opened with a float, collecting the payments and refunds taken while
/// it is open, closed against a physical count per payment method.
model CashierSession {
  id              String               @id @default(cuid())
  hospitalId      String
  sessionNo       String
  status          CashierSessionStatus @default(OPEN)

  openingFloat    Decimal              @default(0) @db.Decimal(10, 2)
  openedById      String
  openedAt        DateTime             @default(now())
  openingNotes    String?              @db.Text

  closedById      String?
  closedAt        DateTime?
  closingNotes    String?              @db.Text

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  hospital        Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  openedBy        User                  @relation("CashierSessionsOpened", fields: [openedById], references: [id])
  closedBy        User?                 @relation("CashierSessionsClosed", fields: [closedById], references: [id])
  payments        Payment[]
  refunds         Refund[]
  counts          CashierSessionCount[]

  @@unique([hospitalId, sessionNo])
  @@index([hospitalId, status, openedAt(sort: Desc)])
}

/// One counted line per payment method on a closed session.
///
/// `expectedAmount` is stamped at close rather than recalculated on read, for
/// the same reason the tax rate is stamped on an invoice: a reconciliation
/// records what was found at the time, and must not drift if a payment is
/// corrected afterwards.
model CashierSessionCount {
  id              String         @id @default(cuid())
  sessionId       String
  paymentMethod   PaymentMethod

  expectedAmount  Decimal        @db.Decimal(10, 2)
  countedAmount   Decimal        @db.Decimal(10, 2)
  varianceAmount  Decimal        @db.Decimal(10, 2)
  notes           String?        @db.Text

  createdAt       DateTime       @default(now())

  session         CashierSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, paymentMethod])
  @@index([sessionId])
}

enum CashierSessionStatus {
  OPEN
  CLOSED
}

enum DiscountApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model InvoiceItem {
  id              String     @id @default(cuid())
  invoiceId       String
  treatmentId     String?

  description     String
  quantity        Int        @default(1)
  unitPrice       Decimal    @db.Decimal(10, 2)
  amount          Decimal    @db.Decimal(10, 2)
  taxable         Boolean    @default(true)

  createdAt       DateTime   @default(now())

  invoice         Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatment       Treatment? @relation(fields: [treatmentId], references: [id])
}

model Payment {
  id              String        @id @default(cuid())
  hospitalId      String
  paymentNo       String
  invoiceId       String

  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentDate     DateTime      @default(now())

  /// The reference the payer or the bank gave: a wallet transaction id, an
  /// IBFT reference, a card authorisation code. Was duplicated by a separate
  /// `upiId` column that recorded the same kind of thing for one rail only.
  transactionId   String?
  bankName        String?
  chequeNumber    String?
  chequeDate      DateTime?

  notes           String?
  status          PaymentStatus @default(COMPLETED)

  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundDate      DateTime?
  refundReason    String?

  // FR-015, and spec §12 which names the cashier on a financial transaction.
  // A payment taken while a till is open belongs to that till's reconciliation.
  cashierSessionId String?
  recordedById    String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  cashierSession  CashierSession? @relation(fields: [cashierSessionId], references: [id])
  recordedBy      User?         @relation("PaymentsRecorded", fields: [recordedById], references: [id])
  refunds         Refund[]

  @@unique([hospitalId, paymentNo])
  @@index([hospitalId, paymentDate(sort: Desc)])
  @@index([invoiceId])
  @@index([hospitalId, cashierSessionId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

/// How money reached the clinic.
///
/// `UPI` is gone. It is India's instant-payment rail, and no Pakistani clinic
/// can take one — while the two things a Pakistani patient actually pays with
/// already had values here: a mobile wallet (JazzCash, Easypaisa, SadaPay) is
/// `WALLET`, and Raast or an interbank transfer is `BANK_TRANSFER`. Keeping it
/// meant a payment method on the till screen that nobody could ever select
/// honestly, and a line on every daily reconciliation that was always zero.
/// `INSURANCE` is gone too. There is no insurance module — the tables went in
/// `39fdd2e` and the screens that survived them called endpoints that do not
/// exist — so a payment recorded against a claim nobody could raise was a
/// second method on the till that could not be chosen honestly.
enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  /// A mobile-money wallet: JazzCash, Easypaisa, SadaPay.
  WALLET
  /// Taken through a payment gateway on the clinic's own booking pages. No
  /// processor is integrated yet — see CHANGES.md §11.1.
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  // Some of the money has gone back but not all of it. Without this a payment
  // refunded in part had to be marked either COMPLETED (hiding the refund) or
  // REFUNDED (claiming the whole amount went back).
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

// ==================== INVENTORY MANAGEMENT ====================


model InventoryItem {
  id              String    @id @default(cuid())
  hospitalId      String
  sku             String
  name            String
  /// A label, not a table. `InventoryCategory` was eleven columns and a
  /// self-referencing hierarchy in support of a free-text field on a form: the
  /// UI offered no way to create, rename or nest one, so every clinic's
  /// categories arrived from the seed and stayed there.
  category        String?
  description     String?   @db.Text
  itemType        InventoryItemType @default(DENTAL_MATERIAL)
  // The supplier this item is normally bought from. `SupplierItem` used to sit
  // beside it recording every supplier that stocks an item with their own SKU,
  // price and lead time — a table nothing ever wrote to, which is why the
  // inventory list's "supplier" column was always empty.
  preferredSupplierId String?

  unit            String
  currentStock    Int       @default(0)
  minimumStock    Int       @default(10)
  reorderLevel    Int       @default(20)
  maximumStock    Int?

  purchasePrice   Decimal   @db.Decimal(10, 2)
  sellingPrice    Decimal?  @db.Decimal(10, 2)
  /// Customs/tax classification for the item, where the clinic records one.
  /// Was `hsnCode` — India's GST term for it.
  taxCode         String?
  taxPercentage   Decimal?  @db.Decimal(5, 2)

  imageUrl        String?
  notes           String?   @db.Text

  manufacturer    String?
  batchTracking   Boolean   @default(false)
  expiryTracking  Boolean   @default(false)

  storageLocation String?
  storageConditions String?

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  preferredSupplier Vendor?   @relation("PreferredSupplierItems", fields: [preferredSupplierId], references: [id])
  stockTransactions StockTransaction[]
  batches         InventoryBatch[]
  purchaseOrderItems PurchaseOrderItem[]
  alerts          StockAlert[]

  @@unique([hospitalId, sku])
  @@index([preferredSupplierId])
  @@index([hospitalId, deletedAt, name])
  @@index([hospitalId, deletedAt, itemType])
  @@index([hospitalId, deletedAt, category])
}

enum InventoryItemType {
  DENTAL_MATERIAL
  INSTRUMENT
  CONSUMABLE
  MEDICINE
  OFFICE_SUPPLY
  EQUIPMENT
}

model InventoryBatch {
  id              String    @id @default(cuid())
  hospitalId      String
  itemId          String
  batchNumber     String
  quantity        Int
  remainingQty    Int
  purchasePrice   Decimal   @db.Decimal(10, 2)
  manufacturingDate DateTime?
  expiryDate      DateTime?
  supplierId      String?
  receivedDate    DateTime  @default(now())

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id])
  supplier        Vendor?   @relation(fields: [supplierId], references: [id])
  stockTransactions StockTransaction[]
  alerts          StockAlert[]

  @@unique([hospitalId, itemId, batchNumber])
  @@index([hospitalId, itemId])
  @@index([hospitalId, expiryDate])
}

model StockTransaction {
  id              String               @id @default(cuid())
  hospitalId      String
  itemId          String
  type            StockTransactionType
  quantity        Int
  previousStock   Int
  newStock        Int
  batchNumber     String?

  batchId         String?
  supplierId      String?

  referenceType   String?
  referenceId     String?

  // Where stock moved between, for transfer transactions.
  fromLocation    String?
  toLocation      String?

  unitPrice       Decimal?             @db.Decimal(10, 2)
  totalPrice      Decimal?             @db.Decimal(10, 2)

  notes           String?
  performedBy     String?

  // When the movement happened, which is not always when the row was written
  // (back-dated stock takes, delayed goods-receipt entry).
  transactionDate DateTime             @default(now())
  createdAt       DateTime             @default(now())

  hospital        Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem        @relation(fields: [itemId], references: [id])
  batch           InventoryBatch?      @relation(fields: [batchId], references: [id])
  supplier        Vendor?              @relation(fields: [supplierId], references: [id])

  @@index([batchId])
  @@index([supplierId])
  @@index([hospitalId, transactionDate(sort: Desc)])
  @@index([hospitalId, itemId, transactionDate(sort: Desc)])
  @@index([hospitalId, type, transactionDate(sort: Desc)])
}

enum StockTransactionType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
  EXPIRED
  RETURNED
  TRANSFERRED
  CONSUMPTION
}

/// An organisation the clinic does business with: a supplier of materials, or
/// a dental laboratory.
///
/// These were two tables, `Supplier` and `LabVendor`, with twenty-seven columns
/// in common — code, name, contact, address, both tax identifiers, bank
/// details, payment terms, credit limit, rating, status, soft delete. They
/// differed in two fields, both of which only a laboratory uses. Every change
/// to how the clinic records a business contact had to be made twice, and one
/// of the two was always the one that got forgotten: `LabVendor` never received
/// the `@@unique([hospitalId, code])` that `Supplier` has, so two laboratories
/// could quietly share a code.
///
/// A dental laboratory *is* a supplier — of crowns rather than composite. What
/// differs is what the clinic sends them, and that is on `LabOrder`, not here.
model Vendor {
  id                String       @id @default(cuid())
  hospitalId        String
  kind              VendorKind

  /// The clinic's own reference. Optional because laboratories were never
  /// required to have one; unique per clinic *and kind*, so a supplier and a
  /// laboratory may both be "V001" without one migration renaming the other.
  code              String?
  name              String
  contactPerson     String?
  email             String?
  phone             String
  alternatePhone    String?
  address           String?      @db.Text
  city              String?
  state             String?
  postalCode        String?

  taxRegistrationNo String?
  nationalTaxNo     String?
  bankAccountNo     String?
  bankIban          String?

  paymentTerms      String?
  creditLimit       Decimal?     @db.Decimal(12, 2)
  /// 0-5, the clinic's own judgement of them.
  rating            Int?         @default(0)
  notes             String?      @db.Text

  /// One lifecycle field, not two. Both tables carried an `isActive` boolean
  /// *and* this enum, and the schema comment on `isActive` admitted it merely
  /// mirrored `status != BLOCKED/INACTIVE` — two columns that could disagree,
  /// with nothing deciding which one won.
  status            VendorStatus @default(ACTIVE)

  /// Laboratories only: the work they take on, and their usual turnaround in
  /// days. Null on a supplier, and nothing asks a supplier for them.
  specializations   String?      @db.Text
  avgTurnaround     Int?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  hospital          Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  purchaseOrders    PurchaseOrder[]
  batches           InventoryBatch[]
  preferredForItems InventoryItem[]    @relation("PreferredSupplierItems")
  stockTransactions StockTransaction[]
  labOrders         LabOrder[]

  @@unique([hospitalId, kind, code])
  @@index([hospitalId, kind, deletedAt, name])
  @@index([hospitalId, kind, status])
}

enum VendorKind {
  SUPPLIER
  LAB
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  hospitalId      String
  orderNumber     String
  supplierId      String

  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  receivedDate    DateTime?

  subtotal        Decimal             @db.Decimal(10, 2)
  taxAmount       Decimal             @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal             @db.Decimal(10, 2)

  status          PurchaseOrderStatus @default(DRAFT)
  notes           String?             @db.Text

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  supplier        Vendor              @relation(fields: [supplierId], references: [id])
  items           PurchaseOrderItem[]

  @@unique([hospitalId, orderNumber])
  @@index([hospitalId, deletedAt, status, orderDate(sort: Desc)])
  @@index([hospitalId, supplierId, orderDate(sort: Desc)])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  itemId          String

  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Decimal       @db.Decimal(10, 2)
  amount          Decimal       @db.Decimal(10, 2)

  createdAt       DateTime      @default(now())

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  /// `itemId` was a bare string with no foreign key, so a line could name an
  /// item that does not exist and nothing would say so.
  item            InventoryItem @relation(fields: [itemId], references: [id])

  @@index([purchaseOrderId])
  @@index([itemId])
}

/// The states an order actually passes through.
///
/// `SUBMITTED` and `APPROVED` are gone. They described an internal approval
/// chain — raise, submit, have a manager approve, then order — which needs an
/// approver capability, a queue to approve from and a notification, none of
/// which existed. A practice manager orders gloves; there is nobody upstairs to
/// ask. Discounts and refunds are where this project puts approval (FR-013/014),
/// because there the money leaves against a patient's bill.
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Low-stock and expiry alerts raised against an inventory item.
///
/// The *existence* of an alert is derivable from stock levels, and it is
/// tempting to compute the list and drop the table. What is not derivable is
/// the acknowledgement — who saw it, when, and what they wrote — and a clinic
/// that has already ordered more gloves needs the alert to stop shouting before
/// the stock level changes. So the row stays; `lib/stock-alerts.ts` keeps it in
/// step with the stock level, in one place rather than the three hand-written
/// copies it used to be.
///
/// `alertDate` is gone: it defaulted to now() beside `createdAt`, which also
/// defaults to now(), and nothing ever set either of them to anything else.
model StockAlert {
  id              String         @id @default(cuid())
  hospitalId      String
  itemId          String
  /// Which delivery, for an expiry alert. A shortage is about the item as a
  /// whole and carries none; an expiry is always about one batch, because two
  /// batches of the same composite expire on different days and acknowledging
  /// one must not silence the other.
  batchId         String?

  alertType       StockAlertType

  isAcknowledged  Boolean        @default(false)
  acknowledgedBy  String?
  acknowledgedAt  DateTime?

  notes           String?        @db.Text

  createdAt       DateTime       @default(now())

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item            InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batch           InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  acknowledgedByUser User?       @relation(fields: [acknowledgedBy], references: [id])

  @@index([hospitalId, isAcknowledged, createdAt(sort: Desc)])
  @@index([itemId, alertType, isAcknowledged])
  @@index([batchId, alertType, isAcknowledged])
}

enum StockAlertType {
  OUT_OF_STOCK
  LOW_STOCK
  EXPIRING_SOON
  EXPIRED
}

