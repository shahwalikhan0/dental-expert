/// Files attached to a lab order (scans, prescriptions, shade photos).
/// Replaces the legacy `lab_order_documents` table.
model LabOrderDocument {
  id              String    @id @default(cuid())
  labOrderId      String

  fileName        String
  fileUrl         String
  fileType        String?
  fileSize        Int?
  documentType    String?
  uploadedBy      String?

  createdAt       DateTime  @default(now())

  labOrder        LabOrder  @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  uploadedByUser  User?     @relation(fields: [uploadedBy], references: [id])

  @@index([labOrderId])
  @@index([createdAt])
}

enum LabWorkType {
  CROWN
  BRIDGE
  DENTURE
  PARTIAL_DENTURE
  IMPLANT_CROWN
  VENEER
  INLAY_ONLAY
  NIGHT_GUARD
  RETAINER
  ALIGNER
  MODEL
  OTHER
}

enum LabOrderPriority {
  NORMAL
  URGENT
}

enum LabOrderStatus {
  CREATED
  SENT_TO_LAB
  IN_PROGRESS
  QUALITY_CHECK
  READY
  DELIVERED
  FITTED
  REMAKE_REQUIRED
  CANCELLED
}

enum QualityCheckStatus {
  PENDING
  PASSED
  FAILED
  CONDITIONALLY_PASSED
}

// ==================== DOCUMENTS ====================

model Document {
  id              String       @id @default(cuid())
  hospitalId      String
  patientId       String
  treatmentId     String?

  fileName        String
  originalName    String
  fileType        String
  fileSize        Int
  filePath        String

  documentType    DocumentType
  description     String?

  isArchived      Boolean      @default(false)
  uploadedBy      String?

  // Annotation data (Phase 6)
  annotations     Json?        // Array of annotation objects [{type, points, color, text, ...}]
  annotatedBy     String?      // userId who annotated
  annotatedAt     DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  hospital        Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient         Patient      @relation(fields: [patientId], references: [id])
  treatment       Treatment?   @relation(fields: [treatmentId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([documentType])
}

enum DocumentType {
  XRAY
  CT_SCAN
  PHOTO
  CONSENT_FORM
  PRESCRIPTION
  LAB_REPORT
  INSURANCE
  ID_PROOF
  OTHER
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id              String           @id @default(cuid())
  hospitalId      String
  userId          String

  title           String
  message         String           @db.Text
  type            NotificationType

  isRead          Boolean          @default(false)
  readAt          DateTime?

  entityType      String?
  entityId        String?

  createdAt       DateTime         @default(now())

  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  APPOINTMENT
  PAYMENT
  INVENTORY
  SYSTEM
}

// ==================== AUDIT LOGS ====================

model AuditLog {
  id              String    @id @default(cuid())
  hospitalId      String
  userId          String?

  action          String
  entityType      String
  entityId        String

  oldValues       String?   @db.Text
  newValues       String?   @db.Text

  ipAddress       String?
  userAgent       String?

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User?     @relation(fields: [userId], references: [id])

  @@index([hospitalId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ==================== SETTINGS ====================

model Setting {
  id              String    @id @default(cuid())
  hospitalId      String
  key             String
  value           String    @db.Text
  type            String    @default("string")
  category        String    @default("general")
  description     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, key])
  @@index([hospitalId])
  @@index([category])
}

model Holiday {
  id              String    @id @default(cuid())
  hospitalId      String
  name            String
  date            DateTime  @db.Date
  isRecurring     Boolean   @default(false)

  createdAt       DateTime  @default(now())

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([date])
}

// ==================== COMMUNICATION SYSTEM ====================

model CommunicationTemplate {
  id              String              @id @default(cuid())
  hospitalId      String
  name            String
  category        TemplateCategory
  channel         CommunicationChannel

  subject         String?
  content         String              @db.Text
  variables       String?             @db.Text

  language        String              @default("en")
  isActive        Boolean             @default(true)
  isDefault       Boolean             @default(false)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  smsLogs         SMSLog[]
  emailLogs       EmailLog[]

  @@index([hospitalId])
  @@index([category])
  @@index([channel])
}

model SMSLog {
  id              String        @id @default(cuid())
  hospitalId      String
  patientId       String?
  phone           String

  templateId      String?
  message         String        @db.Text

  gateway         String?
  status          MessageStatus @default(PENDING)
  deliveryStatus  String?

  scheduledFor    DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?

  errorMessage    String?
  cost            Decimal?      @db.Decimal(10, 4)
  messageId       String?

  metadata        String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  template        CommunicationTemplate? @relation(fields: [templateId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([phone])
  @@index([status])
  @@index([sentAt])
}

model EmailLog {
  id              String        @id @default(cuid())
  hospitalId      String
  patientId       String?
  email           String

  templateId      String?
  subject         String
  body            String        @db.Text

  attachments     String?       @db.Text

  status          MessageStatus @default(PENDING)

  scheduledFor    DateTime?
  sentAt          DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  failedAt        DateTime?

  trackingId      String?       @unique  // UUID for open tracking pixel

  errorMessage    String?
  messageId       String?

  metadata        String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  template        CommunicationTemplate? @relation(fields: [templateId], references: [id])

  @@index([hospitalId])
  @@index([patientId])
  @@index([email])
  @@index([status])
  @@index([sentAt])
}

model PatientCommunicationPreference {
  id              String    @id @default(cuid())
  patientId       String    @unique

  smsEnabled      Boolean   @default(true)
  emailEnabled    Boolean   @default(true)
  whatsappEnabled Boolean   @default(false)

  appointmentReminders Boolean @default(true)
  paymentReminders    Boolean  @default(true)
  promotionalMessages Boolean  @default(true)
  birthdayWishes      Boolean  @default(true)

  preferredLanguage   String   @default("en")
  preferredChannel    CommunicationChannel @default(SMS)

  dndRegistered       Boolean  @default(false)
  unsubscribedAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId])
}

model BulkCommunication {
  id              String              @id @default(cuid())
  hospitalId      String
  name            String
  description     String?

  channel         CommunicationChannel
  templateId      String?

  filterCriteria  String?             @db.Text
  recipientCount  Int                 @default(0)

  status          BulkCommStatus      @default(DRAFT)

  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?

  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)

  estimatedCost   Decimal?            @db.Decimal(10, 2)
  actualCost      Decimal?            @db.Decimal(10, 2)

  createdBy       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([status])
  @@index([scheduledFor])
}

enum TemplateCategory {
  APPOINTMENT
  PAYMENT
  BIRTHDAY
  PROMOTIONAL
  FOLLOW_UP
  LAB_WORK
  PRESCRIPTION
  GENERAL
}

enum CommunicationChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
}

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum BulkCommStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

