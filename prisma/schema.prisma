// ==================== DATA IMPORT / ERP MIGRATION ====================

model DataImportJob {
  id              String           @id @default(cuid())
  hospitalId      String
  userId          String

  fileName        String
  fileType        String           // "csv" | "xlsx" | "xls" | "pdf"
  filePath        String
  entityType      String           // "patients" | "appointments" | "treatments" | "invoices" | "payments" | "inventory" | "staff"

  status          DataImportStatus @default(UPLOADED)

  sourceColumns   Json?            // string[]
  columnMapping   Json?            // Record<string, string | null>
  previewData     Json?            // first N rows of parsed data
  validationErrors Json?           // array of { row, field, message }

  totalRows       Int              @default(0)
  successCount    Int              @default(0)
  errorCount      Int              @default(0)

  signedOffAt     DateTime?
  completedAt     DateTime?
  errorLog        String?          @db.Text

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])

  @@index([hospitalId])
  @@index([status])
}

enum DataImportStatus {
  UPLOADED
  MAPPED
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}
