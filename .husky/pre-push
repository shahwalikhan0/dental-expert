#!/usr/bin/env sh
# Guardrail: never push straight to a protected branch.
#
# GitHub rulesets are the real enforcement (they cannot be bypassed by a local
# --no-verify). This hook just fails fast and locally, before the network round
# trip, and before CI burns a runner on a push that will be rejected anyway.
#
# Deliberate override, for the rare case you need it:
#   ALLOW_PROTECTED_PUSH=1 git push origin main

PROTECTED_BRANCHES="main develop"

remote_ref_is_protected() {
  for branch in $PROTECTED_BRANCHES; do
    if [ "$1" = "refs/heads/$branch" ]; then
      return 0
    fi
  done
  return 1
}

# git feeds pre-push one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
ZERO_SHA=0000000000000000000000000000000000000000
CHANGED=""

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue

  if remote_ref_is_protected "$remote_ref"; then
    if [ "$ALLOW_PROTECTED_PUSH" = "1" ]; then
      echo "pre-push: ALLOW_PROTECTED_PUSH=1 set — allowing push to $remote_ref."
    else
      echo ""
      echo "  BLOCKED: refusing to push directly to $remote_ref."
      echo ""
      echo "  Open a pull request instead:"
      echo "    git switch -c my-change"
      echo "    git push -u origin my-change"
      echo "    gh pr create"
      echo ""
      echo "  If you really mean it: ALLOW_PROTECTED_PUSH=1 git push ..."
      echo ""
      exit 1
    fi
  fi

  # Deleting a branch pushes nothing to test.
  [ "$local_sha" = "$ZERO_SHA" ] && continue

  # What this push adds: against what the remote already has, or for a new
  # branch, against where it left main.
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
  else
    base=$remote_sha
  fi
  if [ -z "$base" ] || ! git cat-file -e "$base" 2>/dev/null; then
    CHANGED="__ALL__"
  elif [ "$CHANGED" != "__ALL__" ]; then
    CHANGED="$CHANGED
$(git diff --name-only --diff-filter=ACMR "$base" "$local_sha")"
  fi
done

# Only the tests connected to what is being pushed. `vitest related` follows
# imports from each changed file to the tests that reach it, so a change to
# lib/ledger.ts runs the ledger, billing and statement tests rather than all
# ~3,300. The whole suite runs in CI (the Unit Tests job in ci.yml) on every
# pull request, which is what catches a break in a module nobody touched.
#
# The whole suite locally, when you want it: npm run test
#
# A change to the test setup, the config or the dependencies can move any
# test, so those run everything; so does a push whose base is unknown.
if [ "$CHANGED" = "__ALL__" ] || printf '%s\n' "$CHANGED" |
  grep -qE '^(package(-lock)?\.json|vitest\.config\.ts|tsconfig\.json|tests/setup\.ts|tests/__mocks__/|prisma/schema\.prisma)'; then
  echo "pre-push: running the whole unit suite."
  npm run test
  exit $?
fi

SOURCES=$(printf '%s\n' "$CHANGED" | grep -E '\.(ts|tsx|js|jsx|mjs)$' | grep -v '^tests/e2e/' | sort -u)
if [ -z "$SOURCES" ]; then
  echo "pre-push: no code changed; no unit tests to run."
  exit 0
fi

echo "pre-push: running the tests related to $(printf '%s\n' "$SOURCES" | wc -l | tr -d ' ') changed file(s)."
# shellcheck disable=SC2086 # one argument per file is the point
npx vitest related --run --passWithNoTests $SOURCES
